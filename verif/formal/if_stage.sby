#
# Bounded model check of the fetch stage.  See verif/formal/if_stage_fv.sv
# for what is proven and what is assumed.

[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20

# yices (SMT) for this one: the properties are about control.  abc (SAT)
# was tried for greater depth and does not help here.
#
# Cost: about ten seconds at depth 20 WITHOUT the PMP deny-word model.
# With it (2026-08-31) the deep steps dominate and the full run takes
# about 2 h 50 m -- the anyconst denied word multiplies the state the
# solver must consider even though steps 0..16 stay quick.  Run it when
# the fetch stage changes, not as a per-commit gate; the simulation
# regression is the fast check.
[engines]
smtbmc yices

[script]
read -sv -formal cdriscv_32s_20_if_stage.sv
read -sv -formal if_stage_fv.sv
prep -top if_stage_fv

[files]
rtl/core/cdriscv_32s_20_if_stage.sv
verif/formal/if_stage_fv.sv
