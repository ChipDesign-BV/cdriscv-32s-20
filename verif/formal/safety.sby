rtl/core/cdriscv_32s_20_pkg.sv
rtl/common/cdriscv_32s_20_sync.sv
rtl/common/cdriscv_32s_20_cfg_parity.sv
rtl/safety/cdriscv_32s_20_safety_ctrl.sv
verif/formal/safety_fv.sv
