[tasks]
bmc
[options]
mode bmc
depth 15
[engines]
smtbmc yices
[script]
plugin -i slang
read_slang --top safety_fv --allow-use-before-declare cdriscv_32s_20_pkg.sv cdriscv_32s_20_sync.sv cdriscv_32s_20_cfg_parity.sv cdriscv_32s_20_safety_ctrl.sv safety_fv.sv
prep -top safety_fv
